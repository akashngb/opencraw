{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/designs.html" }
  ],
  "headers": [
    {
      "source": "/project.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/cutouts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
